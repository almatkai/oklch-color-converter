[package]
name = "oklch-beta-contract-harness"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
publish = false
[lib]
test = false
doctest = false
[dependencies]
tezbar-oklch-color-converter = {path=".."}
serde = {version="=1.0.228",features=["derive"]}
serde_json = "=1.0.145"
tokio = {version="=1.47.1",features=["macros","rt-multi-thread","sync","time"]}
uuid = {version="=1.18.1",features=["v4"]}
tempfile = "=3.23.0"
log = "=0.4.28"
